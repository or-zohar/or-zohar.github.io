---
import BaseLayout from './BaseLayout.astro';
import ProjectMediaGallery from '@components/project/ProjectMediaGallery.astro';
import type { Slide } from '@components/project/media';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'photo-projects'> | CollectionEntry<'design-projects'>;
}

const { project } = Astro.props;
const { title, description, cover, hideCoverOnDetail } = project.data;
const basePath = `/${project.collection}`;

const localImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.jpg', { eager: true });

function resolveImage(relPath: string): ImageMetadata | undefined {
  const match = relPath.match(/assets\/(.+)$/);
  return match ? localImages[`/src/assets/${match[1]}`]?.default : undefined;
}

const slides: Slide[] = [];
if (!hideCoverOnDetail) {
  slides.push({ type: 'image', src: cover, alt: title });
}

type BodyMatch = { index: number; type: 'image'; src: string } | { index: number; type: 'video'; src: string; poster: string };
const body = project.body ?? '';
const matches: BodyMatch[] = [];

for (const m of body.matchAll(/!\[[^\]]*\]\(([^)]+)\)/g)) {
  matches.push({ index: m.index ?? 0, type: 'image', src: m[1] });
}
for (const m of body.matchAll(/<video[^>]*\bsrc="([^"]+)"[^>]*\bposter="([^"]+)"[^>]*>/g)) {
  matches.push({ index: m.index ?? 0, type: 'video', src: m[1], poster: m[2] });
}
matches.sort((a, b) => a.index - b.index);

for (const m of matches) {
  if (m.type === 'image') {
    const resolved = resolveImage(m.src);
    if (resolved) slides.push({ type: 'image', src: resolved, alt: title });
  } else {
    slides.push({ type: 'video', src: m.src, poster: m.poster });
  }
}
---

<BaseLayout
  title={`${title} — Portfolio`}
  description={description}
  projectTitle={title}
  projectDescription={description}
  backHref={basePath}
>
  <div class="hero">
    <ProjectMediaGallery slides={slides} />
  </div>
</BaseLayout>

<style>
  :global(main) {
    display: flex;
    flex-direction: column;
  }

  .hero {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    /* the sticky header takes space above; offset it so media is centred on the whole viewport */
    padding-bottom: var(--header-h, 3.6rem);
  }
</style>
