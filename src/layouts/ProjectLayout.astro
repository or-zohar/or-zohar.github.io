---
import BaseLayout from './BaseLayout.astro';
import ProjectHeader from '@components/project/ProjectHeader.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'photo-projects'> | CollectionEntry<'design-projects'>;
}

const { project } = Astro.props;
const { title, description, cover, date, tags } = project.data;
---

<BaseLayout title={`${title} — Portfolio`} description={description}>
  <article>
    <ProjectHeader {title} {description} {cover} {date} {tags} />
    <div class="container project-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .project-content {
    padding-bottom: var(--space-2xl);
  }

  .project-content :global(p) {
    margin-bottom: var(--space-md);
    line-height: 1.75;
  }

  .project-content :global(img) {
    width: 80%;
    margin: var(--space-xl) auto;
    display: block;
  }

  .project-content :global(h2) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }
</style>
