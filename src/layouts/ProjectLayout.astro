---
import BaseLayout from './BaseLayout.astro';
import ProjectHeader from '@components/project/ProjectHeader.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'photo-projects'> | CollectionEntry<'design-projects'>;
}

const { project } = Astro.props;
const { title, description, cover, date, tags, hideCoverOnDetail } = project.data;
---

<BaseLayout title={`${title} — Portfolio`} description={description}>
  <article>
    <ProjectHeader {title} {description} {cover} {date} {tags} showCover={!hideCoverOnDetail} />
    <div class="container project-content">
      <slot />
    </div>
  </article>

  <div class="lightbox" id="lightbox">
    <img id="lightbox-img" alt="" />
  </div>
</BaseLayout>

<style>
  .project-content {
    padding-bottom: var(--space-2xl);
  }

  .project-content :global(p) {
    margin-bottom: var(--space-md);
    line-height: 1.75;
  }

  .project-content :global(p):not(:has(> img, > video)) {
    max-width: 80%;
    margin-inline: auto;
  }

  .project-content :global(img),
  .project-content :global(video) {
    width: 80%;
    margin: var(--space-xl) auto;
    display: block;
  }

  .project-content :global(h2) {
    max-width: 80%;
    margin-inline: auto;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--color-bg);
    padding: var(--space-lg);
    align-items: center;
    justify-content: center;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
</style>

<script>
  function largestSrc(img: HTMLImageElement) {
    if (!img.srcset) return img.src;
    const candidates = img.srcset.split(',').map(entry => {
      const [url, width] = entry.trim().split(/\s+/);
      return { url, width: parseInt(width) || 0 };
    });
    candidates.sort((a, b) => b.width - a.width);
    return candidates[0]?.url || img.src;
  }

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

  document.querySelectorAll('article .project-cover img, .project-content img').forEach(img => {
    img.addEventListener('click', () => {
      lightboxImg.src = largestSrc(img as HTMLImageElement);
      lightboxImg.alt = (img as HTMLImageElement).alt;
      lightbox?.classList.add('active');
    });
  });

  lightbox?.addEventListener('click', event => {
    if (event.target === lightbox) {
      lightbox.classList.remove('active');
    }
  });
</script>
