---
import BaseHead from '@components/layout/BaseHead.astro';
import Header from '@components/layout/Header.astro';
import '../styles/theme.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  projectTitle?: string;
  projectDescription?: string;
  backHref?: string;
  hideIndex?: boolean;
}

const { title, description, image, projectTitle, projectDescription, backHref, hideIndex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {title} {description} {image} />
  </head>
  <body>
    <Header {projectTitle} {projectDescription} {backHref} {hideIndex} />
    <main>
      <slot />
    </main>
  </body>
</html>
