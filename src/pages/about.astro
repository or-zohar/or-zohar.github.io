---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import { siteConfig } from '@config/site';
import aboutPhoto from '@assets/about/about-photo.jpg';
---

<BaseLayout title={`About — ${siteConfig.name}`} description={`About ${siteConfig.name}`}>
  <section class="container about">
    <p>
      Analog photographer and visual communication student, with a strong
      affinity for culture and arts. Focused on typography, print design,
      branding and art direction.
    </p>
    <Image src={aboutPhoto} alt="" widths={[200, 400]} sizes="200px" class="about-photo" />
  </section>
</BaseLayout>

<style>
  .about {
    text-align: center;
    padding-bottom: var(--space-2xl);
  }

  .about p {
    max-width: 50ch;
    margin-inline: auto;
  }

  .about-photo {
    display: block;
    width: 200px;
    margin: var(--space-xl) auto 0;
  }
</style>
