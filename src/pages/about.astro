---
import BaseLayout from '@layouts/BaseLayout.astro';
import { siteConfig } from '@config/site';
---

<BaseLayout title={`About — ${siteConfig.name}`} description={`About ${siteConfig.name}`}>
  <section class="container about">
    <h1>About</h1>
    <p>
      <!-- Replace with a real bio: city, focus, background -->
      Write a short bio here — where you're based, what you focus on, and your background.
    </p>
  </section>
</BaseLayout>

<style>
  .about {
    text-align: center;
    padding-bottom: var(--space-2xl);
  }

  .about p {
    max-width: 50ch;
    margin-inline: auto;
    margin-top: var(--space-md);
  }
</style>
