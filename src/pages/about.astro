---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PagesNav from '@components/layout/PagesNav.astro';
import { siteConfig } from '@config/site';
import aboutPhoto from '@assets/about/about-photo.jpg';
---

<BaseLayout title={`About — ${siteConfig.name}`} description={`About ${siteConfig.name}`}>
  <section class="container about">
    <p>
      Analog photographer and visual communication student at Bezalel
      Academy of Arts and Design, with a strong affinity for culture and
      arts. Focused on typography, print design, branding and art
      direction.
    </p>
    <Image src={aboutPhoto} alt="" widths={[200, 400]} sizes="200px" class="about-photo" />
  </section>
  <PagesNav />
</BaseLayout>

<style>
  main {
    padding-bottom: var(--space-2xl);
  }

  .about {
    text-align: center;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 4 / 3;
    margin-inline: auto;
    padding-inline: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .about p {
    max-width: 50ch;
    margin-inline: auto;
  }

  .about-photo {
    display: block;
    width: 200px;
    margin: var(--space-xl) auto 0;
  }

  @media (max-width: 640px) {
    .about {
      padding-inline: 24px;
    }

    .about-photo {
      width: 144px;
      margin-top: 30px;
      margin-bottom: -21px;
    }
  }
</style>
