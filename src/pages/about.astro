---
import BaseLayout from '@layouts/BaseLayout.astro';
import { siteConfig } from '@config/site';
---

<BaseLayout title={`About — ${siteConfig.name}`} description={`About ${siteConfig.name}`}>
  <section class="container about">
    <h1>About</h1>
    <p>
      Portrait photographer and visual communication student, with a strong
      affinity for culture and arts. Focused on typography, print design,
      branding, and art direction.
    </p>
  </section>
</BaseLayout>

<style>
  .about {
    text-align: center;
    padding-bottom: var(--space-2xl);
  }

  .about p {
    max-width: 50ch;
    margin-inline: auto;
    margin-top: var(--space-md);
  }
</style>
