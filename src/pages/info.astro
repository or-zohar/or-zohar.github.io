---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '@config/site';
import infoPhoto from '../assets/pages/info/info-photo.jpg';
---

<BaseLayout title={`Info — ${siteConfig.name}`} description={`About and contact — ${siteConfig.name}`} backHref="/">
  <section class="info">
    <p class="info-text">
      Hello! I am a film photographer and visual communication student at
      Bezalel Academy of Arts and Design, with a strong affinity for
      culture and arts.<br />
      I focus on typography, print design, branding and art direction.
      I love telling stories, creating for cultural fields, and exploring
      and challenging social perceptions, and I'm drawn to local and
      oriental design with a contemporary twist.
    </p>
    <Image class="info-photo" src={infoPhoto} alt="" widths={[280, 420]} sizes="140px" quality={100} />
    <ul class="contact-list" role="list">
      {siteConfig.social.map(link => (
        <li><a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">{link.label}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  :global(main) {
    display: flex;
    flex-direction: column;
  }

  .info {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
    padding: 10px var(--space-lg) var(--space-2xl);
  }

  .info-text {
    max-width: 60ch;
  }

  .info-photo {
    display: block;
    align-self: flex-start;
    width: 140px;
    height: auto;
    margin-top: calc(var(--space-md) + 20px);
  }

  .contact-list {
    list-style: none;
    margin: calc(var(--space-md) + 20px) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-md) + 10px);
  }

  .contact-list li {
    text-transform: uppercase;
  }

  .contact-list :global(.email-reveal) {
    text-transform: none;
  }

  @media (max-width: 640px) {
    .info-photo {
      width: 110px;
    }

    .info {
      padding-inline: 24px;
    }

    .info-text {
      max-width: 48ch;
    }
  }
</style>

<script>
  // EMAIL reveals the address next to the button instead of opening the mail app
  document.querySelectorAll<HTMLAnchorElement>('.contact-list a[href^="mailto:"]').forEach(link => {
    link.addEventListener('click', event => {
      event.preventDefault();
      if (link.parentElement?.querySelector('.email-reveal')) return;
      const reveal = document.createElement('span');
      reveal.className = 'email-reveal';
      reveal.textContent = ` - ${link.href.replace('mailto:', '')}`;
      link.after(reveal);
    });
  });
</script>
