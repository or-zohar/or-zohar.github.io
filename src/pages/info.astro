---
import BaseLayout from '@layouts/BaseLayout.astro';
import { siteConfig } from '@config/site';
---

<BaseLayout title={`Info — ${siteConfig.name}`} description={`About and contact — ${siteConfig.name}`} backHref="/">
  <section class="info">
    <p class="info-text">
      Hello! I am a photographer and visual communication student at
      Bezalel Academy of Arts and Design, with a strong affinity for
      culture and arts. I am Focused on typography, print design,
      branding and art direction.
    </p>
    <ul class="contact-list" role="list">
      {siteConfig.social.map(link => (
        <li><a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">{link.label}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  :global(main) {
    display: flex;
    flex-direction: column;
  }

  .info {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
    padding: 10px var(--space-lg) var(--space-2xl);
  }

  .info-text {
    max-width: 50ch;
  }

  .contact-list {
    list-style: none;
    margin: calc(var(--space-md) + 10px) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-md) + 10px);
  }

  .contact-list li {
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .info {
      padding-inline: 24px;
    }

    .info-text {
      max-width: 40ch;
    }
  }
</style>
