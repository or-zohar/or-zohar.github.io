---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectList from '@components/project/ProjectList.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@config/site';

const projects = (await getCollection('design-projects'))
  .sort((a, b) => a.data.order - b.data.order || (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---

<BaseLayout title={`Design Projects — ${siteConfig.name}`} description="Graphic design projects.">
  <section class="container">
    <ProjectList projects={projects} basePath="/design-projects" thumbWidth="67.2%" />
  </section>
</BaseLayout>

<style>
  section {
    padding-bottom: var(--space-2xl);
  }
</style>
