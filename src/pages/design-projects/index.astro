---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectGallery from '@components/project/ProjectGallery.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@config/site';

const projects = (await getCollection('design-projects'))
  .sort((a, b) => a.data.order - b.data.order || (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---

<BaseLayout title={`Design Projects — ${siteConfig.name}`} description="Graphic design projects.">
  <div class="hero">
    <ProjectGallery projects={projects} basePath="/design-projects" />
  </div>
</BaseLayout>

<style>
  :global(main) {
    display: flex;
    flex-direction: column;
  }

  .hero {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
