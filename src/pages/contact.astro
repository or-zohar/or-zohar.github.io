---
import BaseLayout from '@layouts/BaseLayout.astro';
import PagesNav from '@components/layout/PagesNav.astro';
import { siteConfig } from '@config/site';
---

<BaseLayout title={`Contact — ${siteConfig.name}`} description={`Get in touch with ${siteConfig.name}`}>
  <section class="container contact">
    <ul class="contact-list" role="list">
      {siteConfig.social.map(link => (
        <li><a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">{link.label}</a></li>
      ))}
    </ul>
  </section>
  <PagesNav />
</BaseLayout>

<style>
  main {
    padding-bottom: var(--space-2xl);
  }

  .contact {
    text-align: center;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 4 / 3;
    margin-inline: auto;
    padding-inline: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .contact-list {
    list-style: none;
    padding: 0;
  }

  .contact-list li {
    line-height: 1.8;
  }

  @media (max-width: 640px) {
    .contact {
      padding-inline: 48px;
    }
  }
</style>
