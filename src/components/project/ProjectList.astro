---
import { Image } from 'astro:assets';
import { withBase } from '@utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'photo-projects'>[] | CollectionEntry<'design-projects'>[];
  basePath: string;
}

const { projects, basePath } = Astro.props;
---

<ul class="project-list" role="list">
  {projects.map(project => (
    <li>
      <a href={project.data.externalUrl || withBase(`${basePath}/${project.slug}`)}>
        <Image
          src={project.data.cover}
          alt={project.data.title}
          widths={[400, 800, 1200]}
          sizes="(max-width: 640px) 90vw, 600px"
        />
      </a>
    </li>
  ))}
</ul>

<style>
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-list li + li {
    margin-top: var(--space-xl);
  }

  .project-list img {
    width: 80%;
    margin-inline: auto;
    display: block;
  }
</style>
