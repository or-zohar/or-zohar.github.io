---
import { Image } from 'astro:assets';
import { withBase } from '@utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'photo-projects'>[] | CollectionEntry<'design-projects'>[];
  basePath: string;
  thumbWidth?: string;
}

const { projects, basePath, thumbWidth = '56%' } = Astro.props;
---

<ul class="project-list" role="list" style={`--thumb-width: ${thumbWidth}`}>
  {projects.map(project => (
    <li>
      <a class="project-link" href={project.data.externalUrl || withBase(`${basePath}/${project.slug}`)}>
        <span class="project-thumb">
          <Image
            src={project.data.cover}
            alt={project.data.title}
            widths={[400, 800, 1200]}
            sizes="(max-width: 640px) 90vw, 600px"
            quality={100}
          />
          <span class="project-name">{project.data.title}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-list li + li {
    margin-top: var(--space-xl);
  }

  .project-link:hover {
    opacity: 1;
  }

  .project-thumb {
    position: relative;
    display: block;
    width: var(--thumb-width, 56%);
    margin-inline: auto;
  }

  .project-thumb img {
    width: 100%;
    display: block;
    transition: opacity var(--transition-fast);
  }

  .project-link:hover .project-thumb img,
  .project-link:focus-visible .project-thumb img {
    opacity: 0.25;
  }

  .project-name {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-md);
    font-size: 1rem;
    color: var(--color-text);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .project-link:hover .project-name,
  .project-link:focus-visible .project-name {
    opacity: 1;
  }
</style>
