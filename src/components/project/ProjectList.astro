---
import { withBase } from '@utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'photo-projects'>[] | CollectionEntry<'design-projects'>[];
  basePath: string;
}

const { projects, basePath } = Astro.props;
---

<ul class="project-list" role="list">
  {projects.map(project => (
    <li>
      <a href={project.data.externalUrl || withBase(`${basePath}/${project.slug}`)}>
        {project.data.title}
      </a>
    </li>
  ))}
</ul>

<style>
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .project-list li {
    line-height: 1.8;
  }
</style>
