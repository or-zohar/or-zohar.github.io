---
import { Image } from 'astro:assets';

export type Slide =
  | { type: 'image'; src: ImageMetadata; alt: string }
  | { type: 'video'; src: string; poster: string };

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<div class="gallery" data-gallery>
  {slides.map((slide, i) => (
    slide.type === 'image' ? (
      <Image
        src={slide.src}
        alt={slide.alt}
        widths={[400, 800, 1200]}
        sizes="(max-width: 640px) 90vw, 600px"
        quality={100}
        loading={i === 0 ? 'eager' : 'lazy'}
        class="gallery-image"
        data-active={i === 0}
      />
    ) : (
      <video
        src={slide.src}
        poster={slide.poster}
        controls
        playsinline
        preload="metadata"
        class="gallery-image"
        data-active={i === 0}
      />
    )
  ))}
  {slides.length > 1 && (
    <>
      <button type="button" class="gallery-zone gallery-prev" aria-label="Previous image"></button>
      <button type="button" class="gallery-zone gallery-next" aria-label="Next image"></button>
    </>
  )}
</div>

<style>
  .gallery {
    position: relative;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 4 / 3;
    margin-inline: auto;
  }

  .gallery-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 1s ease;
    pointer-events: none;
  }

  .gallery-image[data-active="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  .gallery-zone {
    position: absolute;
    top: 0;
    bottom: 48px;
    width: 20%;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    z-index: 1;
  }

  .gallery-prev {
    left: 0;
    cursor: w-resize;
  }

  .gallery-next {
    right: 0;
    cursor: e-resize;
  }
</style>

<script>
  const galleries = document.querySelectorAll<HTMLElement>('[data-gallery]');

  galleries.forEach(gallery => {
    const items = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery-image'));
    if (items.length < 2) return;

    let current = 0;

    const show = (index: number) => {
      const prevItem = items[current];
      if (prevItem instanceof HTMLVideoElement) prevItem.pause();
      prevItem.dataset.active = 'false';
      current = (index + items.length) % items.length;
      items[current].dataset.active = 'true';
    };

    gallery.querySelector('.gallery-prev')?.addEventListener('click', () => show(current - 1));
    gallery.querySelector('.gallery-next')?.addEventListener('click', () => show(current + 1));
  });
</script>
