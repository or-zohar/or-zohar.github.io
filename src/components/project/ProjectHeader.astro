---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  cover: ImageMetadata;
  date?: Date;
  tags: string[];
}

const { title, description, cover, date, tags } = Astro.props;
const meta = [
  date?.toLocaleDateString('en-US', { year: 'numeric', month: 'long' }),
  tags.length > 0 ? tags.join(', ') : undefined,
].filter(Boolean).join(' — ');
---

<header class="project-header container">
  <h1>{title}</h1>
  {description && <p class="project-desc">{description}</p>}
  {meta && <p class="project-meta">{meta}</p>}

  <div class="project-cover">
    <Image src={cover} alt={title} widths={[400, 800, 1200]} sizes="(max-width: 640px) 90vw, 600px" />
  </div>
</header>

<style>
  .project-header {
    text-align: center;
  }

  .project-header h1 {
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  .project-desc {
    color: var(--color-text-secondary);
    margin-top: var(--space-sm);
  }

  .project-meta {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    margin-top: var(--space-sm);
  }

  .project-cover {
    margin-top: var(--space-lg);
  }

  .project-cover img {
    width: 80%;
    margin-inline: auto;
    display: block;
  }
</style>
