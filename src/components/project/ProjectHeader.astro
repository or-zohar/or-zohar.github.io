---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  cover: ImageMetadata;
  date?: Date;
  tags: string[];
  showCover?: boolean;
}

const { title, description, cover, date, tags, showCover = true } = Astro.props;
const meta = [
  date?.toLocaleDateString('en-US', { year: 'numeric', month: 'long' }),
  tags.length > 0 ? tags.join(', ') : undefined,
].filter(Boolean).join(' — ');
---

<header class="project-header container">
  <h1>{title}</h1>
  {description && (
    <p class="project-desc">
      {description.split('{mobile-break}').map((part, i, arr) => (
        <>
          {part}
          {i < arr.length - 1 && <span class="mobile-break" />}
        </>
      ))}
    </p>
  )}
  {meta && <p class="project-meta">{meta}</p>}

  {showCover && (
    <div class="project-cover">
      <Image src={cover} alt={title} widths={[400, 800, 1200, 1800]} sizes="(max-width: 640px) 90vw, 600px" quality={100} />
    </div>
  )}
</header>

<style>
  .project-header {
    text-align: center;
  }

  .project-header h1 {
    font-size: 1rem;
    color: var(--color-text);
  }

  .project-desc {
    color: var(--color-text);
    opacity: 0.6;
    margin-top: var(--space-sm);
    max-width: 80%;
    margin-inline: auto;
    white-space: pre-line;
  }

  .mobile-break {
    display: none;
  }

  @media (max-width: 640px) {
    .mobile-break {
      display: block;
    }
  }

  .project-meta {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    margin-top: var(--space-sm);
  }

  .project-cover {
    margin-top: var(--space-xl);
  }

  .project-cover img {
    width: 80%;
    margin-inline: auto;
    display: block;
  }
</style>
