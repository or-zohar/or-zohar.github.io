---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  cover: ImageMetadata;
  date: Date;
  tags: string[];
}

const { title, description, cover, date, tags } = Astro.props;
---

<header class="project-header container">
  <h1>{title}</h1>
  <p class="project-desc">{description}</p>
  <p class="project-meta">
    {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
    {tags.length > 0 && ` — ${tags.join(', ')}`}
  </p>

  <div class="project-cover">
    <Image src={cover} alt={title} widths={[400, 800, 1200]} sizes="(max-width: 640px) 90vw, 600px" />
  </div>
</header>

<style>
  .project-header {
    text-align: center;
    padding-bottom: var(--space-xl);
  }

  .project-desc {
    color: var(--color-text-secondary);
    margin-top: var(--space-sm);
  }

  .project-meta {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    margin-top: var(--space-sm);
  }

  .project-cover {
    margin-top: var(--space-lg);
  }

  .project-cover img {
    width: 100%;
  }
</style>
