---
import { Image } from 'astro:assets';
import type { Slide } from './media';

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;

// Phone layout: rows of three that fill the screen edge to edge (see ProjectGrid.astro).
const PER_ROW = 3;
const aspects = slides.map(slide => (slide.type === 'image' ? slide.src.width / slide.src.height : 16 / 9));
const average = aspects.reduce((sum, a) => sum + a, 0) / Math.max(aspects.length, 1);
const rows = Array.from({ length: Math.ceil(slides.length / PER_ROW) }, (_, r) =>
  slides.slice(r * PER_ROW, r * PER_ROW + PER_ROW).map((slide, j) => ({ slide, i: r * PER_ROW + j })),
);
---

<section class="index" data-index hidden aria-label="Project index">
  <div class="index-grid" role="list">
    {rows.map(row => (
      <div class="grid-row" role="presentation">
        {row.map(({ slide, i }) => (
          <div class="grid-item" role="listitem" style={`--a: ${aspects[i]}`}>
            <button type="button" data-index-item={i} aria-label={`Show image ${i + 1}`}>
              {slide.type === 'image' ? (
                <Image
                  src={slide.src}
                  alt=""
                  widths={[300, 600, 900]}
                  sizes="(max-width: 640px) 34vw, 400px"
                  quality={100}
                  loading={i < 6 ? 'eager' : 'lazy'}
                />
              ) : (
                <img src={slide.poster} alt="" loading={i < 6 ? 'eager' : 'lazy'} />
              )}
              <span class="index-number">{String(i + 1).padStart(2, '0')}</span>
            </button>
          </div>
        ))}
        {Array.from({ length: PER_ROW - row.length }, () => (
          <div class="grid-filler" aria-hidden="true" style={`--a: ${average}`}></div>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .index {
    --thumb-height: 215px;
    padding: 10px var(--space-lg) calc(var(--space-2xl) + var(--space-sm) + 0.875rem * 1.2);
  }

  .index[hidden] {
    display: none;
  }

  .index-grid {
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 64px calc(var(--space-lg) * 2);
    align-items: flex-start;
  }

  .grid-row {
    display: contents;
  }

  .grid-filler {
    display: none;
  }

  .index-grid button {
    position: relative;
    display: block;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .index-grid img {
    display: block;
    height: var(--thumb-height);
    width: auto;
  }

  .index-number {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    line-height: 1.2;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    /* three images per row across the screen; row heights differ with the images' proportions */
    .index {
      padding-inline: var(--space-md);
    }

    .index-grid {
      display: block;
    }

    .grid-row {
      display: flex;
      gap: var(--space-sm);
      margin-bottom: 36px;
    }

    .grid-row:last-child {
      margin-bottom: 0;
    }

    .grid-item,
    .grid-filler {
      flex: var(--a) 1 0;
      min-width: 0;
    }

    .grid-filler {
      display: block;
    }

    .index-grid button {
      width: 100%;
    }

    .index-grid img {
      width: 100%;
      height: auto;
    }
  }
</style>

<script>
  const index = document.querySelector<HTMLElement>('[data-index]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const toggles = document.querySelectorAll<HTMLElement>('[data-index-toggle]');

  if (index && hero) {
    const setOpen = (open: boolean) => {
      index.hidden = !open;
      hero.hidden = open;
      toggles.forEach(t => t.setAttribute('aria-pressed', String(open)));
      document.documentElement.toggleAttribute('data-index-open', open);
      if (open) {
        window.scrollTo(0, 0);
      }
    };

    toggles.forEach(toggle =>
      toggle.addEventListener('click', event => {
        event.preventDefault();
        setOpen(index.hidden);
      }),
    );

    index.querySelectorAll<HTMLElement>('[data-index-item]').forEach(item =>
      item.addEventListener('click', () => {
        setOpen(false);
        document
          .querySelector('[data-gallery]')
          ?.dispatchEvent(new CustomEvent('gallery:goto', { detail: Number(item.dataset.indexItem) }));
      }),
    );

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !index.hidden) setOpen(false);
    });
  }
</script>
