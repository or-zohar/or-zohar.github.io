---
import { Image } from 'astro:assets';
import { withBase } from '@utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'photo-projects'>[] | CollectionEntry<'design-projects'>[];
  basePath: string;
}

const { projects, basePath } = Astro.props;
const links = projects.map(project => project.data.externalUrl || withBase(`${basePath}/${project.slug}`));
---

<div class="gallery" data-gallery data-links={JSON.stringify(links)}>
  {projects.map((project, i) => (
    <Image
      src={project.data.cover}
      alt={project.data.title}
      widths={[400, 800, 1200]}
      sizes="(max-width: 640px) 90vw, 600px"
      quality={100}
      loading={i === 0 ? 'eager' : 'lazy'}
      class="gallery-image"
      data-active={i === 0}
    />
  ))}
  <button type="button" class="gallery-zone gallery-prev" aria-label="Previous project"></button>
  <a class="gallery-zone gallery-link" href={links[0]} aria-label="View project"></a>
  <button type="button" class="gallery-zone gallery-next" aria-label="Next project"></button>
</div>

<style>
  .gallery {
    position: relative;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 4 / 3;
    margin-inline: auto;
  }

  .gallery-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .gallery-image[data-active="true"] {
    opacity: 1;
  }

  .gallery-zone {
    position: absolute;
    inset: 0;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }

  .gallery-prev {
    width: 25%;
    left: 0;
    cursor: w-resize;
  }

  .gallery-link {
    width: 50%;
    left: 25%;
  }

  .gallery-next {
    width: 25%;
    left: 75%;
    cursor: e-resize;
  }
</style>

<script>
  const galleries = document.querySelectorAll<HTMLElement>('[data-gallery]');

  galleries.forEach(gallery => {
    const images = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery-image'));
    const link = gallery.querySelector<HTMLAnchorElement>('.gallery-link');
    const links: string[] = JSON.parse(gallery.dataset.links || '[]');
    if (images.length < 2 || !link) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    const show = (index: number) => {
      images[current].dataset.active = 'false';
      current = (index + images.length) % images.length;
      images[current].dataset.active = 'true';
      link.href = links[current];
    };

    const restart = () => {
      clearInterval(timer);
      timer = setInterval(() => show(current + 1), 4000);
    };

    gallery.querySelector('.gallery-prev')?.addEventListener('click', () => {
      show(current - 1);
      restart();
    });

    gallery.querySelector('.gallery-next')?.addEventListener('click', () => {
      show(current + 1);
      restart();
    });

    restart();
  });
</script>
