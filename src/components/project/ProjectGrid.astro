---
import { Image } from 'astro:assets';
import { withBase } from '@utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'photo-projects'>[] | CollectionEntry<'design-projects'>[];
  basePath: string;
  heading: string;
  id: string;
}

const { projects, basePath, heading, id } = Astro.props;
---

<section class="project-section" id={id}>
  <h2 class="section-heading">{heading}</h2>
  <ul class="project-grid" role="list">
    {projects.map((project, i) => (
      <li>
        <a
          href={project.data.externalUrl || withBase(`${basePath}/${project.slug}`)}
          aria-label={project.data.title}
        >
          <Image
            src={project.data.cover}
            alt=""
            widths={[300, 600, 900]}
            sizes="(max-width: 640px) 60vw, 400px"
            quality={100}
            loading={i < 6 ? 'eager' : 'lazy'}
          />
          <span class="project-number">{String(i + 1).padStart(2, '0')}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .project-section {
    --thumb-height: 200px;
    padding: var(--space-lg) var(--space-lg) 0;
    scroll-margin-top: 3.6rem;
  }

  .project-section:first-of-type {
    padding-top: 10px;
  }

  .project-section + .project-section {
    padding-top: var(--space-xl);
  }

  .project-section:last-of-type {
    padding-bottom: var(--space-2xl);
  }

  .section-heading {
    margin: 0 0 var(--space-lg);
    font-size: 1rem;
    font-weight: normal;
    line-height: 1.6;
    color: var(--color-text);
  }

  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl) var(--space-lg);
    align-items: flex-start;
  }

  .project-grid a {
    display: block;
  }

  .project-grid img {
    display: block;
    height: var(--thumb-height);
    width: auto;
  }

  .project-number {
    display: block;
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    line-height: 1.2;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .project-section {
      --thumb-height: 130px;
      padding-inline: var(--space-md);
    }

    .project-section:first-of-type {
      padding-top: 10px;
    }

    .project-grid {
      gap: var(--space-lg) var(--space-md);
    }
  }
</style>
