---
import { Image } from 'astro:assets';
import { withBase } from '@utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'photo-projects'>[] | CollectionEntry<'design-projects'>[];
  basePath: string;
  heading: string;
  id: string;
  showHeading?: boolean;
}

const { projects, basePath, heading, id, showHeading = true } = Astro.props;

// Phone layout: rows of three that fill the screen edge to edge (row height follows the
// images' proportions). On wider screens the rows are transparent (display: contents).
const PER_ROW = 3;
const aspectOf = (project: (typeof projects)[number]) => {
  const cover = project.data.cover as ImageMetadata;
  return cover.width / cover.height;
};
const aspects = projects.map(aspectOf);
const average = aspects.reduce((sum, a) => sum + a, 0) / Math.max(aspects.length, 1);
const rows = Array.from({ length: Math.ceil(projects.length / PER_ROW) }, (_, r) =>
  projects.slice(r * PER_ROW, r * PER_ROW + PER_ROW).map((project, j) => ({ project, i: r * PER_ROW + j })),
);
---

<section class="project-section" id={id}>
  <h2 class={showHeading ? 'section-heading' : 'sr-only'}>{heading}</h2>
  <div class="project-grid" role="list">
    {rows.map(row => (
      <div class="grid-row" role="presentation">
        {row.map(({ project, i }) => (
          <div class="grid-item" role="listitem" style={`--a: ${aspects[i]}`}>
            <a
              href={project.data.externalUrl || withBase(`${basePath}/${project.slug}`)}
              aria-label={project.data.title}
            >
              <Image
                src={project.data.cover}
                alt=""
                widths={[300, 600, 900]}
                sizes="(max-width: 640px) 34vw, 400px"
                quality={100}
                loading={i < 6 ? 'eager' : 'lazy'}
              />
              <span class="project-number">{String(i + 1).padStart(2, '0')}</span>
            </a>
          </div>
        ))}
        {Array.from({ length: PER_ROW - row.length }, () => (
          <div class="grid-filler" aria-hidden="true" style={`--a: ${average}`}></div>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .project-section {
    --thumb-height: 215px;
    padding: var(--space-lg) var(--space-lg) calc(var(--space-sm) + 0.875rem * 1.2);
    scroll-margin-top: 3.6rem;
  }

  .project-section:first-of-type {
    padding-top: 10px;
  }

  .project-section + .project-section {
    padding-top: calc(var(--space-md) + 10px);
  }

  .project-section:last-of-type {
    padding-bottom: var(--space-2xl);
  }

  /* heading kept for screen readers and the page outline, not drawn */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .section-heading {
    margin: 0 0 var(--space-lg);
    font-size: 1rem;
    font-weight: normal;
    line-height: 1.6;
    color: var(--color-text);
  }

  .project-grid {
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 64px calc(var(--space-lg) * 2);
    align-items: flex-start;
  }

  .grid-row {
    display: contents;
  }

  .grid-filler {
    display: none;
  }

  .project-grid a {
    display: block;
    position: relative;
  }

  .project-grid img {
    display: block;
    height: var(--thumb-height);
    width: auto;
  }

  .project-number {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    line-height: 1.2;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    /* three images per row, edge to edge; row heights differ with the images' proportions */
    .project-section {
      padding-inline: 0;
    }

    .project-section:first-of-type {
      padding-top: 10px;
    }

    .section-heading {
      padding-inline: var(--space-md);
    }

    .project-grid {
      display: block;
    }

    .grid-row {
      display: flex;
      gap: var(--space-sm);
      margin-bottom: 64px;
    }

    .grid-row:last-child {
      margin-bottom: 0;
    }

    .grid-item,
    .grid-filler {
      flex: var(--a) 1 0;
      min-width: 0;
    }

    .grid-filler {
      display: block;
    }

    .project-grid img {
      width: 100%;
      height: auto;
    }
  }
</style>
