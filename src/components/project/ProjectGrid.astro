---
import { Image } from 'astro:assets';
import { withBase } from '@utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'photo-projects'>[] | CollectionEntry<'design-projects'>[];
  basePath: string;
  heading: string;
  id: string;
  justify?: boolean;
}

const { projects, basePath, heading, id, justify = false } = Astro.props;
---

<section class="project-section" id={id}>
  <h2 class="section-heading">{heading}</h2>
  <ul class="project-grid" role="list" data-justify={justify ? "" : undefined}>
    {projects.map((project, i) => (
      <li>
        <a
          href={project.data.externalUrl || withBase(`${basePath}/${project.slug}`)}
          aria-label={project.data.title}
        >
          <Image
            src={project.data.cover}
            alt=""
            widths={[300, 600, 900]}
            sizes="(max-width: 640px) 60vw, 400px"
            quality={100}
            loading={i < 6 ? 'eager' : 'lazy'}
          />
          <span class="project-number">{String(i + 1).padStart(2, '0')}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .project-section {
    --thumb-height: 200px;
    padding: var(--space-lg) var(--space-lg) calc(var(--space-sm) + 0.875rem * 1.2);
    scroll-margin-top: 3.6rem;
  }

  .project-section:first-of-type {
    padding-top: 10px;
  }

  .project-section + .project-section {
    padding-top: calc(var(--space-md) + 10px);
  }

  .project-section:last-of-type {
    padding-bottom: var(--space-2xl);
  }

  .section-heading {
    margin: 0 0 var(--space-lg);
    font-size: 1rem;
    font-weight: normal;
    line-height: 1.6;
    color: var(--color-text);
  }

  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 64px calc(var(--space-lg) * 2);
    align-items: flex-start;
  }

  .project-grid a {
    display: block;
    position: relative;
  }

  .project-grid img {
    display: block;
    height: var(--thumb-height);
    width: auto;
  }

  .project-number {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    line-height: 1.2;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .project-section {
      --thumb-height: 130px;
      padding-inline: var(--space-md);
    }

    .project-section:first-of-type {
      padding-top: 10px;
    }

    .project-grid {
      gap: 64px calc(var(--space-md) * 2);
    }
  }
</style>

<script>
  // Stretch each row so its last project ends at the same margin the first one starts at.
  const grids = document.querySelectorAll<HTMLElement>('[data-justify]');

  const justify = (grid: HTMLElement) => {
    const imgs = Array.from(grid.querySelectorAll<HTMLImageElement>('img'));
    imgs.forEach(img => img.style.removeProperty('height'));

    const style = getComputedStyle(grid);
    const gap = parseFloat(style.columnGap) || 0;
    const width = grid.clientWidth;
    const base = imgs[0]?.getBoundingClientRect().height;
    if (!base) return;

    const aspects = imgs.map(img => Number(img.getAttribute('width')) / Number(img.getAttribute('height')));
    if (aspects.some(a => !a)) return;

    // same greedy row breaking the flex-wrap layout does at the base height
    const rows: number[][] = [];
    let row: number[] = [];
    let used = 0;
    aspects.forEach((aspect, i) => {
      const w = aspect * base;
      if (row.length && used + gap + w > width) {
        rows.push(row);
        row = [];
        used = 0;
      }
      used += (row.length ? gap : 0) + w;
      row.push(i);
    });
    if (row.length) rows.push(row);

    rows.forEach((indexes, r) => {
      const gaps = gap * (indexes.length - 1);
      const natural = indexes.reduce((sum, i) => sum + aspects[i] * base, 0) + gaps;
      const isPartialLast = r === rows.length - 1 && natural < width * 0.7;
      if (isPartialLast) return;
      const height = Math.floor(((width - gaps) / indexes.reduce((sum, i) => sum + aspects[i], 0)) * 100) / 100;
      indexes.forEach(i => (imgs[i].style.height = `${height}px`));
    });
  };

  const run = () => grids.forEach(justify);
  run();
  let timer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(run, 100);
  });
</script>
