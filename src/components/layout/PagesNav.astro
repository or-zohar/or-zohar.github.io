---
import { siteConfig } from '@config/site';
import { withBase } from '@utils/url';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<nav class="pages-nav" aria-label="Site pages">
  <ul role="list">
    {siteConfig.nav.pages.map(link => (
      <li><a href={withBase(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .pages-nav {
    margin-top: var(--space-xl);
    text-align: center;
  }

  .pages-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pages-nav li {
    line-height: 1.6;
  }

  .pages-nav a[aria-current="page"] {
    opacity: 0.6;
  }
</style>
