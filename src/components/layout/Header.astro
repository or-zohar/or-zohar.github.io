---
import { siteConfig } from '@config/site';
import { withBase } from '@utils/url';

const year = new Date().getFullYear();
const home = withBase('/');

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="container">
    <p class="site-title">
      <a href={home}>&copy; {year}, <span class="site-name">{siteConfig.name}</span></a><br />
      {siteConfig.tagline}
    </p>
  </div>
</header>

<nav class="site-nav" aria-label="Main navigation">
  <div class="container">
    <ul class="nav-group" role="list">
      {siteConfig.nav.work.map(link => (
        <li><a href={withBase(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: calc(var(--space-2xl) / 2);
    padding-bottom: var(--space-md);
    text-align: center;
    mix-blend-mode: difference;
    color: #ffffff;
  }

  .site-header a {
    color: #ffffff;
  }

  .site-title {
    font-size: 1rem;
    line-height: 1.5;
  }

  .site-name {
    text-transform: uppercase;
  }

  .site-nav {
    padding-bottom: var(--space-xl);
    text-align: center;
  }

  .nav-group {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-group li {
    line-height: 1.6;
  }

  .nav-group a[aria-current="page"] {
    opacity: 0.6;
  }
</style>
