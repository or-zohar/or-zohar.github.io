---
import { siteConfig } from '@config/site';
import { withBase } from '@utils/url';

interface Props {
  projectTitle?: string;
  projectDescription?: string;
  backHref?: string;
}

const { projectTitle, backHref } = Astro.props;
const projectDescription = Astro.props.projectDescription?.replaceAll('{mobile-break}', ' ');

const home = withBase('/');
const year = new Date().getFullYear();

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = withBase(href.split('#')[0]).replace(/\/$/, '');
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="header-inner">
    {projectTitle ? (
      <div class="project-id">
        <p class="project-title">{projectTitle}</p>
        {projectDescription && <p class="project-description">{projectDescription}</p>}
      </div>
    ) : (
      <a href={home} class="site-name">&copy; {year}, {siteConfig.name}</a>
    )}
    <nav class="site-nav" aria-label="Main navigation">
      <ul role="list">
        {backHref ? (
          <>
            {projectTitle && <li><a href="#index" data-index-toggle aria-pressed="false">INDEX</a></li>}
            <li><a href={withBase(backHref)} data-back>BACK</a></li>
          </>
        ) : (
          [...siteConfig.nav.work, ...siteConfig.nav.pages].map(link => (
            <li><a href={withBase(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
          ))
        )}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
  }

  .header-inner {
    position: relative;
    padding: var(--space-md) var(--space-lg);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    column-gap: var(--space-md);
  }

  .site-name {
    font-size: 1rem;
    color: var(--color-text);
    text-transform: uppercase;
  }

  .project-id {
    position: absolute;
    top: var(--space-md);
    left: var(--space-lg);
    width: calc(100% / 3 - var(--space-lg));
    z-index: 1;
  }

  .project-title,
  .project-description {
    font-size: 16px;
    color: var(--color-text);
    margin: 0;
  }

  :global(html[data-index-open]) .project-id {
    background: var(--color-bg);
  }

  .project-description {
    white-space: pre-line;
    opacity: 0.6;
    margin-top: var(--space-md);
  }

  .site-nav {
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    gap: calc(var(--space-lg) * 0.7);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a[aria-current="page"],
  .site-nav a[aria-pressed="true"] {
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: center;
      row-gap: var(--space-sm);
      padding-inline: var(--space-md);
      text-align: center;
    }

    .project-id {
      position: static;
      width: auto;
    }

    .site-nav {
      margin-left: 0;
    }

    .site-nav ul {
      justify-content: center;
      flex-wrap: wrap;
      gap: calc(var(--space-md) * 0.7);
    }

    .site-name {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const syncHeaderHeight = () => {
    if (header) document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
  };
  syncHeaderHeight();
  window.addEventListener('resize', syncHeaderHeight);

  document.querySelectorAll<HTMLAnchorElement>('[data-back]').forEach(link => {
    link.addEventListener('click', event => {
      if (window.history.length > 1) {
        event.preventDefault();
        window.history.back();
      }
    });
  });
</script>
