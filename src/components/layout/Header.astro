---
import { siteConfig } from '@config/site';
import { withBase } from '@utils/url';

interface Props {
  projectTitle?: string;
  projectDescription?: string;
  backHref?: string;
}

const { projectTitle, backHref } = Astro.props;
const projectDescription = Astro.props.projectDescription?.replaceAll('{mobile-break}', ' ');

const home = withBase('/');
const year = new Date().getFullYear();

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="header-inner">
    {projectTitle ? (
      <div class="project-id">
        <p class="project-title">{projectTitle}</p>
        {projectDescription && <p class="project-description">{projectDescription}</p>}
      </div>
    ) : (
      <a href={home} class="site-name">&copy; {year}, {siteConfig.name}</a>
    )}
    {!backHref && (
      <nav class="site-nav work-nav" aria-label="Work navigation">
        <ul role="list">
          {siteConfig.nav.work.map(link => (
            <li><a href={withBase(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    )}
    {backHref ? (
      <nav class="site-nav back-nav" aria-label="Back navigation">
        <ul role="list">
          <li><a href={withBase(backHref)} data-back>BACK</a></li>
        </ul>
      </nav>
    ) : (
      <nav class="site-nav pages-nav" aria-label="Pages navigation">
        <ul role="list">
          {siteConfig.nav.pages.map(link => (
            <li><a href={withBase(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
  }

  .header-inner {
    padding: var(--space-md) var(--space-lg);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: var(--space-md);
  }

  .site-name {
    font-size: 1rem;
    color: var(--color-text);
    justify-self: start;
    text-transform: uppercase;
  }

  .project-id {
    justify-self: start;
  }

  .project-title,
  .project-description {
    font-size: 1rem;
    color: var(--color-text);
    margin: 0;
  }

  .project-description {
    opacity: 0.6;
  }

  .work-nav {
    justify-self: center;
  }

  .pages-nav,
  .back-nav {
    grid-column: 3;
    justify-self: end;
    align-self: start;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a[aria-current="page"] {
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .header-inner {
      grid-template-columns: 1fr;
      row-gap: var(--space-sm);
      padding-inline: var(--space-md);
      text-align: center;
    }

    .site-name,
    .project-id,
    .work-nav,
    .pages-nav,
    .back-nav {
      grid-column: auto;
      justify-self: center;
    }

    .site-nav ul {
      justify-content: center;
      gap: var(--space-md);
    }

    .site-name,
    .project-title,
    .project-description {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-back]').forEach(link => {
    link.addEventListener('click', event => {
      if (window.history.length > 1) {
        event.preventDefault();
        window.history.back();
      }
    });
  });
</script>
