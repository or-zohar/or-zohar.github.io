---
import { siteConfig } from '@config/site';
import { withBase } from '@utils/url';

const home = withBase('/');

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="header-inner">
    <a href={home} class="site-name">{siteConfig.name}</a>
    <nav class="site-nav" aria-label="Main navigation">
      <ul role="list">
        {siteConfig.nav.work.map(link => (
          <li><a href={withBase(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
  }

  .header-inner {
    max-width: 1100px;
    margin-inline: auto;
    padding: var(--space-md) var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-name {
    font-size: 1rem;
    color: var(--color-text);
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a[aria-current="page"] {
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .header-inner {
      padding-inline: var(--space-md);
    }

    .site-nav ul {
      gap: var(--space-md);
    }

    .site-name {
      font-size: 0.875rem;
    }
  }
</style>
